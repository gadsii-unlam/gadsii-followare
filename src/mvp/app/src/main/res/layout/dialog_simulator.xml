<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simulador de Novedades (TP5)"
        android:textColor="@color/primary_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Selecciona un escenario para simular una notificación y probar el deep link:"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimularAlgebraMaterial"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="start|center_vertical"
        android:text="📄 Álgebra I: Nueva Guía Unidad 2 (Flujo Principal)"
        android:textColor="@color/primary"
        android:textSize="12sp"
        app:strokeColor="@color/primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimularAlgebraMensaje"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="start|center_vertical"
        android:text="💬 Álgebra I: Mensaje cambio de aula"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        app:strokeColor="@color/border_subtle" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimularQuimicaFecha"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="start|center_vertical"
        android:text="📅 Química: Fecha de 1° Parcial"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        app:strokeColor="@color/border_subtle" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimularIntraconsulta"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="start|center_vertical"
        android:text="🏛️ Intraconsulta: Inscripción a finales"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        app:strokeColor="@color/border_subtle" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="@color/border_subtle" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResetSession"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔄 Reiniciar Sesión de Prueba (Restablecer Datos)"
        android:textColor="#DC3545"
        android:textSize="12sp" />

</LinearLayout>

